# ============================================================================
# EvidenceOS — API environment template
# ----------------------------------------------------------------------------
# Copy to `.env` for local dev. Never commit `.env`.
# ============================================================================

# ---- Environment ----
APP_ENV=local
HOST=127.0.0.1
PORT=8012

# ---- CORS ----
# Comma-separated list. Add production domains here later.
CORS_ORIGINS=["http://localhost:3000"]

# ---- Supabase (wired Phase 0.5) ----
# Defaults below are the Supabase CLI's fixed local-dev demo values -- the
# same on every machine, not a secret -- for the local stack started with
# `npx supabase start` (see Project_Docs/Learnings/Phase_7_Deployment/
# 03_operations_runbook.md). Run `npx supabase status` any time to confirm
# these match your running stack. Swap for a real cloud project's
# URL/keys only if you deliberately want local dev to hit staging/
# production data instead -- not recommended, see that same doc for why.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# SERVICE_ROLE_KEY bypasses Row-Level Security. Backend-only secret --
# the value below is still just the fixed local demo key, not a real one.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ---- LLM (field extraction + RAG) ----
OPENAI_API_KEY=<openai-api-key>

# ---- Langfuse (EU region for GDPR) ----
LANGFUSE_PUBLIC_KEY=<langfuse-public-key>
LANGFUSE_SECRET_KEY=<langfuse-secret-key>
LANGFUSE_HOST=https://eu.cloud.langfuse.com

# ---- Document encryption (Phase 12+) ----
# Base64-encoded 256-bit AES-GCM key. MUST match DOCUMENT_ENCRYPTION_KEY in
# apps/web's env exactly -- it's a shared secret between backend and
# frontend (see app/core/encryption.py). Generate with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
DOCUMENT_ENCRYPTION_KEY=<base64-32-byte-key>

