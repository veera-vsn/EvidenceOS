# ============================================================================
# EvidenceOS API dependencies — source of truth.
# ----------------------------------------------------------------------------
# Add packages here (unpinned or minimally pinned). Then run:
#   .venv/Scripts/pip install -r requirements.in
#   .venv/Scripts/pip freeze > requirements.txt
# `requirements.txt` is the lockfile committed for reproducible installs.
# ============================================================================

# --- Web framework ---
fastapi              # ASGI framework — Pydantic-native, async-first, auto OpenAPI.
uvicorn[standard]    # ASGI server. `[standard]` pulls in fast uvloop + httptools.

# --- Configuration ---
pydantic>=2          # Data validation (used by FastAPI internally).
pydantic-settings    # Typed .env loading — replaces the old BaseSettings.

# --- HTTP client (for calling Supabase REST, LLM APIs later) ---
httpx                # Async HTTP client. Same author as requests.

# --- Supabase client (Phase 0.5+) ---
supabase             # Postgres + Auth + Storage SDK. Wraps postgrest, gotrue, storage3.

# --- Logging ---
structlog            # Structured JSON logs — required for observability + audit.

# --- LLM (Phase 3+) ---
openai               # OpenAI API — field extraction, recommendations, RAG.
langfuse>=2,<3       # LLM observability — v2 uses REST API (v3+ switched to OTEL, unstable).

# --- OCR / text extraction (Phase 2+) ---
pdfplumber           # PDF text extraction (no external binaries needed).
                     # Was PyMuPDF until 2026-07-19 -- AGPL/commercial
                     # dual-licensed, not safe unmodified in a closed-
                     # source backend. See extractor.py's docstring.
python-docx          # DOCX text extraction.
openpyxl             # XLSX cell reading.
# CSV uses Python stdlib — no extra package needed.

# --- Dev-only (kept in main file for simplicity; split later) ---
pytest               # Test runner.
pytest-asyncio       # Enables `async def test_...`.
ruff                 # Linter + formatter. Replaces black + isort + flake8.
