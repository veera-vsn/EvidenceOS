# ============================================================================
# EvidenceOS — Web app environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` for local development. Never commit `.env.local`.
# Vars prefixed `NEXT_PUBLIC_` are exposed to the browser.
# ============================================================================

# ---- App metadata ----
NEXT_PUBLIC_APP_ENV=local

# ---- Backend API ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8012

# ---- Supabase (wired Phase 0.5) ----
# Public keys — safe to ship to the browser; Row-Level Security enforces isolation.
# Defaults below are the Supabase CLI's fixed local-dev demo values — the
# same on every machine, not a secret — for the local stack started with
# `npx supabase start` (see Project_Docs/Learnings/Phase_7_Deployment/
# 03_operations_runbook.md). Swap for a real cloud project's URL/anon key
# only if you deliberately want to point local dev at staging/production
# data instead — not recommended, see that same doc for why.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ---- Document encryption (Phase 12+) ----
# Server-only — never prefix this NEXT_PUBLIC_. MUST match
# DOCUMENT_ENCRYPTION_KEY in apps/api's env exactly, byte for byte — it's a
# shared secret used to decrypt extraction_results.extracted_value in
# Server Components (see lib/crypto/document-encryption.ts).
DOCUMENT_ENCRYPTION_KEY=
