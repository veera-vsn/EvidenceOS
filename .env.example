# ============================================================================
# EvidenceOS — Root environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Each app (apps/web, apps/api) has its own `.env.example` too — this file
# documents what's shared and where to find per-app envs.
# ============================================================================

# ---- Environment ----
# One of: local | development | staging | production
NODE_ENV=local
APP_ENV=local

# ---- Supabase (shared between frontend and backend) ----
# Get these from https://supabase.com/dashboard/project/<project-id>/settings/api
# EU region only (Frankfurt or Ireland) — DORA data residency requirement.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<public-anon-key>
# SERVICE_ROLE_KEY bypasses Row-Level Security. Backend only. Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-backend-only>

# ---- Frontend-specific ----
# See apps/web/.env.example for the full list.
# Vars prefixed NEXT_PUBLIC_* are shipped to the browser.

# ---- Backend-specific ----
# See apps/api/.env.example for the full list (DB URL, LLM keys, etc.).
